<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tohraan.flow-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <!-- caffeinate -i: no idle sleep while the daemon runs (lid-closed sleep needs flow-away-mode). -->
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/usr/local/bin/node</string>
    <string>FLOW_TOOLS_DIR/flow-daemon-v2.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FLOW_APP_URL</key>
    <string>APP_URL_HERE</string>
    <key>FLOW_DAEMON_SECRET</key>
    <string>SECRET_HERE</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/flow-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/flow-daemon.error.log</string>
</dict>
</plist>
