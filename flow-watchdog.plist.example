<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Every 60 s: restarts a hung daemon (stale ~/Flow/heartbeat) and reports away-mode/low-battery events. -->
  <key>Label</key>
  <string>com.tohraan.flow-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>FLOW_TOOLS_DIR/flow-watchdog.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FLOW_APP_URL</key>
    <string>APP_URL_HERE</string>
    <key>FLOW_DAEMON_SECRET</key>
    <string>SECRET_HERE</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/flow-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/flow-watchdog.error.log</string>
</dict>
</plist>
